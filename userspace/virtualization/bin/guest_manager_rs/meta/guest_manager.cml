{
    children: [
        {
            name: "vmm",
            url: "#meta/vmm.cm",
        },
    ],
    capabilities: [
        {
            protocol: [ "fuchsia.virtualization.GuestManager" ],
        },
    ],
    use: [
        {
            directory: "pkg",
            from: "#guest_pkg",
            rights: [ "r*" ],
            path: "/guest_pkg",
        },
        {
            protocol: [
                "fuchsia.virtualization.Guest",
                "fuchsia.virtualization.GuestLifecycle",
            ],
            from: "#vmm",
        },
    ],
}
