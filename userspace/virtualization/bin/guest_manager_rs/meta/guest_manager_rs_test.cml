{
    include: [
        "//sdk/lib/syslog/client.shard.cml",
        "//userspace/sys/test_runners/tmp_storage.shard.cml",
    ],
    program: {
        binary: "bin/guest_manager_bin_bin_test",
    },
    use: [
        // tests create and serve directories in /tmp
        {
            storage: "tmp",
            path: "/tmp",
        },
    ],
}
