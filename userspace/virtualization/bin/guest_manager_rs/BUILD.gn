import("//release/components.gni")
import("//release/rust/rustc_binary.gni")

group("packages") {
  testonly = true
  # The SMOS tree does not contain the Debian guest image subpackage. Keep
  # the parent virtualization build contract while compiling the manager
  # binary without wiring an incomplete runtime package into the product.
  deps = [ ":guest_manager_bin" ]
}

group("tests") {
  testonly = true
  deps = [ ":guest_manager_rs_test" ]
}

rustc_binary("guest_manager_bin") {
  name = "guest_manager_bin"
  edition = "2024"
  with_unit_tests = true

  sources = [
    "src/guest_config.rs",
    "src/guest_manager.rs",
    "src/main.rs",
  ]

  deps = [
    "//sdk/fidl/fuchsia.hardware.network:fuchsia.hardware.network_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
    "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust",
    "//sdk/fidl/fuchsia.virtualization:fuchsia.virtualization_rust",
    "//sdk/rust/zx",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/fuchsia-fs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:static_assertions",
  ]

  test_deps = [
    "//userspace/lib/async-utils",
    "//third_party/rust_crates:tempfile",
  ]
}

fuchsia_unittest_package("guest_manager_rs_test") {
  deps = [ ":guest_manager_bin_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
