group("drivers") {
  testonly = true
  deps = [ "drivers/optee" ]
}

group("tests") {
  testonly = true
  deps = []
  if (current_cpu == "arm64" && !smos_minimal_assembly) {
    deps = [ "drivers/optee:tests" ]
  }
}
