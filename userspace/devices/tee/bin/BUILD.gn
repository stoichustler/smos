import("//release/assembly/bootfs_files_for_assembly.gni")
import("//release/testing/cc_test_executable.gni")

cc_test_executable("tee-test") {
  visibility = [ ":*" ]
  sources = [ "tee-test.c" ]
  deps = [
    "//sdk/lib/fdio",
    "//userspace/security/lib/tee/tee-client-api",
    "//userspace/zircon/lib/zircon",
  ]
}

bootfs_files_for_assembly("bootfs") {
  deps = [ ":tee-test" ]
}
