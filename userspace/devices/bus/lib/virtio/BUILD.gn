import("//release/components.gni")
import("//release/cpp/library_headers.gni")
import("//release/test.gni")

source_set("logging") {
  sources = [ "logging.h" ]
  public_deps = [ "//zircon/system/public" ]
  visibility = [ ":*" ]
}

source_set("logging-dfv1") {
  sources = [ "logging-dfv1.cc" ]
  public_deps = [ ":logging" ]
  deps = [
    "//userspace/lib/ddk",
    "//zircon/system/public",
  ]
}

source_set("logging-dfv2") {
  sources = [ "logging-dfv2.cc" ]
  public_deps = [ ":logging" ]
  deps = [
    "//sdk/lib/driver/logging/cpp",
    "//zircon/system/public",
  ]
}

source_set("zxlogf") {
  sources = [ "zxlogf.h" ]
  public_deps = [ ":logging" ]
}

group("tests") {
  testonly = true
  deps = [
    ":virtio",
    ":virtio-backend-test-package",
  ]
}

test("virtio-backend-test") {
  sources = [ "backend_tests.cc" ]
  deps = [
    ":virtio",
    "//sdk/lib/async-default",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/async_patterns/testing/cpp",
    "//sdk/lib/component/outgoing/cpp",
    "//userspace/devices/pci/testing:pci-protocol-fake",
    "//userspace/devices/testing/fake-bti",
    "//userspace/devices/testing/mock-ddk",
    "//zircon/system/ulib/zxtest",
  ]

  # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
  configs += [ "//release/config:Wno-conversion" ]
}

fuchsia_unittest_package("virtio-backend-test-package") {
  component_name = "virtio-backend-test"
  deps = [ ":virtio-backend-test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

library_headers("virtio-headers") {
  headers = [
    "lib/virtio/driver_utils.h",
    "lib/virtio/device.h",
    "lib/virtio/ring.h",
    "lib/virtio/backends/backend.h",
    "lib/virtio/backends/fake.h",
    "lib/virtio/backends/pci.h",
  ]
  public_deps = [
    "//userspace/devices/lib/dma-buffer",
    "//userspace/devices/lib/mmio",
    "//userspace/devices/pci/lib/device-protocol-pci",
    "//userspace/lib/ddk",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/pretty",
    "//zircon/system/ulib/virtio",
    "//zircon/system/ulib/zircon-internal",
    "//zircon/system/ulib/zx",
  ]
  visibility = [ ":virtio-common" ]
}

source_set("virtio-common") {
  configs += [ "//release/config:all_source" ]
  sources = [
    "backends/pci.cc",
    "backends/pci_legacy.cc",
    "backends/pci_modern.cc",
    "device.cc",
    "driver_utils.cc",
    "ring.cc",
  ]
  public_deps = [
    ":virtio-headers",
    ":zxlogf",
  ]
  deps = [
    "//sdk/lib/stdcompat",
    "//userspace/lib/ddk:ddk-deprecated-mmio-headers",
    "//zircon/system/ulib/pretty",
  ]

  # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
  configs += [ "//release/config:Wno-conversion" ]
}

group("virtio") {
  public_deps = [
    ":virtio-common",
    ":logging-dfv1",
    "//userspace/devices/lib/driver",
  ]
}

group("virtio-dfv2") {
  public_deps = [
    ":virtio-common",
    ":logging-dfv2",
  ]
}
