group("drivers") {
  testonly = true
  deps = [
    "drivers/aml-cpu",
    "drivers/aml-cpu-legacy",
  ]
}

group("tests") {
  testonly = true

  deps = []
  if (!smos_minimal_assembly) {
    deps += [ "bin:tests" ]
    if (current_cpu == "arm64") {
      deps += [ "drivers:tests" ]
    }
  }
}
