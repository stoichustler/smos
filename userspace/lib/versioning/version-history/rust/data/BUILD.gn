import("//release/components.gni")
import("//release/rust/rustc_library.gni")

rustc_library("data") {
  name = "version_history_data"

  edition = "2021"
  with_unit_tests = true

  configs -= [ "//release/config/rust/lints:allow_unused_results" ]

  deps = [
    "//userspace/lib/versioning/version-history/rust",
    "//userspace/lib/versioning/version-history/rust/proc-macro",
  ]

  sources = [ "src/lib.rs" ]
}

group("tests") {
  testonly = true
  deps = [ ":data_test($host_toolchain)" ]
}
