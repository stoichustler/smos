import("//release/components.gni")
import("//release/test.gni")

source_set("uuid") {
  sources = [
    "uuid.cc",
    "uuid.h",
  ]

  deps = [ "//userspace/lib/fxl:string_printf" ]
}

test("uuid_unittests") {
  sources = [ "uuid_unittest.cc" ]

  deps = [
    ":uuid",
    "//userspace/lib/fxl/test:gtest_main",
    "//third_party/googletest:gtest",
    "//third_party/re2",
  ]
}

fuchsia_unittest_package("uuid_tests") {
  deps = [ ":uuid_unittests" ]
}

group("tests") {
  testonly = true

  deps = [
    ":uuid_tests",
    ":uuid_unittests($host_toolchain)",
  ]
}
