import("//release/host.gni")
import("//release/rust/rustc_library.gni")

assert(is_host, "Assembly libraries are host-only")

rustc_library("assembly_manifest") {
  edition = "2021"
  name = "assembly_manifest"
  version = "0.1.0"
  with_unit_tests = true
  deps = [
    "//userspace/lib/assembly/util",
    "//userspace/lib/utf8_path",
    "//userspace/sys/pkg/lib/fuchsia-pkg",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:camino",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
  ]
  sources = [
    "src/assembly_manifest.rs",
    "src/lib.rs",
  ]
  test_deps = [ "//third_party/rust_crates:tempfile" ]
  configs += [ "//release/config/rust/lints:clippy_warn_all" ]
}
