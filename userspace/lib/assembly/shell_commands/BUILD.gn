import("//release/host.gni")
import("//release/rust/rustc_library.gni")

assert(is_host, "Assembly libraries are host-only")

rustc_library("shell_commands") {
  edition = "2021"
  name = "assembly_shell_commands"
  version = "0.1.0"
  with_unit_tests = true
  deps = [
    "//userspace/lib/assembly/config_schema",
    "//userspace/lib/assembly/constants",
    "//userspace/lib/assembly/package_utils",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/sys/pkg/lib/fuchsia-pkg",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:camino",
    "//tools/lib/cml",
  ]
  test_deps = [ "//third_party/rust_crates:tempfile" ]
  sources = [
    "src/lib.rs",
    "src/shell_commands.rs",
  ]
}
