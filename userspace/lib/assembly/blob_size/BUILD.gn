import("//release/host.gni")
import("//release/rust/rustc_library.gni")

assert(is_host, "Assembly libraries are host-only")

rustc_library("blob_size") {
  edition = "2021"
  name = "assembly_blob_size"
  with_unit_tests = true
  deps = [
    "//userspace/lib/assembly/blobfs",
    "//userspace/lib/assembly/images_config",
    "//userspace/lib/assembly/tool",
    "//userspace/lib/assembly/util",
    "//userspace/sys/pkg/lib/fuchsia-hash",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:camino",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:tempfile",
  ]
  test_deps = [ "//third_party/rust_crates:serde_json" ]
  sources = [
    "src/blob_size.rs",
    "src/lib.rs",
  ]
}
