import("//userspace/developer/ffx/build/ffx_plugin.gni")

ffx_plugin("ffx_product_download") {
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  edition = "2021"
  with_unit_tests = true

  args_deps = [
    "//userspace/developer/ffx/core:lib",
    "//userspace/developer/ffx/lib/pbms:lib",
    "//third_party/rust_crates:argh",
  ]
  args_sources = [ "src/args.rs" ]
  sources = [ "src/lib.rs" ]

  deps = [
    "//userspace/developer/ffx/config:lib",
    "//userspace/developer/ffx/core:lib",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/pbms:lib",
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/developer/ffx/plugins/product/common:lib",
    "//userspace/developer/ffx/plugins/product/list:ffx_product_list",
    "//userspace/lib/gcs",
    "//userspace/lib/structured_ui",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-fs",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:tempfile",
    "//third_party/rust_crates:tracing",
    "//third_party/rust_crates:url",
  ]

  test_deps = [
    "//userspace/lib/fuchsia",
    "//userspace/lib/testing/fuchsia-hyper-test-support",
    "//third_party/rust_crates:tempfile",
  ]
}
