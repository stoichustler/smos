import("//release/host.gni")
import("//release/rust/rustc_binary.gni")
import("//release/rust/rustc_library.gni")
import("//release/zircon/tools.gni")
import("//userspace/developer/ffx/build/ffx_tool.gni")

assert(is_host)

group("tests") {
  testonly = true
  deps = [
    ":ffx_assembly_args_test",
    ":ffx_assembly_test",
  ]
}

rustc_library("ffx_assembly_args") {
  version = "0.1.0"
  edition = "2021"
  with_unit_tests = true
  sources = [ "src/args.rs" ]
  source_root = "src/args.rs"

  deps = [
    "//userspace/lib/assembly/images_config",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:camino",
  ]
}

rustc_library("ffx_assembly") {
  version = "0.1.0"
  edition = "2021"
  with_unit_tests = true

  sources = [
    "src/base_package.rs",
    "src/blobfs.rs",
    "src/compiled_package.rs",
    "src/extra_hash_descriptor.rs",
    "src/fvm.rs",
    "src/fxfs.rs",
    "src/lib.rs",
    "src/operations.rs",
    "src/operations/create_system.rs",
    "src/operations/create_update.rs",
    "src/operations/product.rs",
    "src/operations/product/assembly_builder.rs",
    "src/operations/size_check.rs",
    "src/operations/size_check/breakdown.rs",
    "src/operations/size_check/common.rs",
    "src/operations/size_check/diff.rs",
    "src/operations/size_check/package.rs",
    "src/operations/size_check/product.rs",
    "src/operations/size_check/visualization.rs",
    "src/subpackage_blobs_package.rs",
    "src/vbmeta.rs",
    "src/vfs.rs",
    "src/zbi.rs",
  ]
  inputs = [
    "src/operations/size_check/index.html",
    "src/operations/size_check/D3BlobTreeMap.js",
    "//tools/scripts/third_party/d3_v3/d3.js",
    "//tools/scripts/third_party/d3_v3/LICENSE",
  ]

  deps = [
    ":ffx_assembly_args",
    "//userspace/developer/ffx/lib/errors:lib",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/pbms:lib",
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/lib/assembly/assembly_manifest",
    "//userspace/lib/assembly/base_package",
    "//userspace/lib/assembly/blob_size",
    "//userspace/lib/assembly/blobfs",
    "//userspace/lib/assembly/components",
    "//userspace/lib/assembly/config_capabilities",
    "//userspace/lib/assembly/config_data",
    "//userspace/lib/assembly/config_schema",
    "//userspace/lib/assembly/constants",
    "//userspace/lib/assembly/container",
    "//userspace/lib/assembly/domain_config",
    "//userspace/lib/assembly/driver_manifest",
    "//userspace/lib/assembly/file_relative_path",
    "//userspace/lib/assembly/fvm",
    "//userspace/lib/assembly/fxfs",
    "//userspace/lib/assembly/images_config",
    "//userspace/lib/assembly/memory_buckets",
    "//userspace/lib/assembly/named_file_map",
    "//userspace/lib/assembly/package_list",
    "//userspace/lib/assembly/package_utils",
    "//userspace/lib/assembly/partitions_config",
    "//userspace/lib/assembly/platform_configuration",
    "//userspace/lib/assembly/shell_commands",
    "//userspace/lib/assembly/structured_config",
    "//userspace/lib/assembly/subpackage_blobs_package",
    "//userspace/lib/assembly/tool",
    "//userspace/lib/assembly/update_package",
    "//userspace/lib/assembly/update_packages_manifest",
    "//userspace/lib/assembly/util",
    "//userspace/lib/assembly/validate_package",
    "//userspace/lib/assembly/validate_util",
    "//userspace/lib/assembly/vbmeta",
    "//userspace/lib/assembly/zbi",
    "//userspace/lib/fuchsia-url",
    "//userspace/lib/gcs",
    "//userspace/lib/structured_ui",
    "//userspace/lib/utf8_path",
    "//userspace/sys/pkg/lib/epoch",
    "//userspace/sys/pkg/lib/fuchsia-hash",
    "//userspace/sys/pkg/lib/fuchsia-merkle",
    "//userspace/sys/pkg/lib/fuchsia-pkg",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:camino",
    "//third_party/rust_crates:hex",
    "//third_party/rust_crates:itertools",
    "//third_party/rust_crates:rayon",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:textwrap",
    "//third_party/rust_crates:tracing",
    "//third_party/rust_crates:url",
  ]
  test_deps = [
    "//userspace/lib/assembly/test_keys",
    "//userspace/lib/assembly/test_util",
    "//userspace/lib/fuchsia-async",
    "//userspace/storage/blobfs/tools:blobfs",
    "//userspace/sys/pkg/lib/far/rust:fuchsia-archive",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:camino",
    "//third_party/rust_crates:pretty_assertions",
    "//third_party/rust_crates:regex",
    "//third_party/rust_crates:tempfile",
  ]

  # TODO(https://fxbug.dev/356474618): re-enable and fix existing lints
  # configs = [ "//release/config/rust/lints:clippy_warn_all" ]
}

ffx_tool("ffx_assembly_tool") {
  edition = "2021"
  output_name = "ffx-assembly"
  deps = [
    ":ffx_assembly",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/lib/fuchsia-async",
  ]
  sources = [ "src/main.rs" ]

  sdk_target_name = "sdk"
  sdk_category = "partner"

  # We avoid instrumenting assembly for certain builds as this negatively impacts performance.
  exclude_toolchain_tags = [
    "asan",
    "coverage",
    "profile",
  ]
}

group("assembly") {
  public_deps = [ ":ffx_assembly_tool_host_tool" ]
}

group("bin") {
  public_deps = [ ":ffx_assembly_tool_versioned" ]
}
