import("//userspace/developer/ffx/build/ffx_plugin.gni")

if (is_host) {
  ffx_plugin("ffx_emulator_console") {
    sdk_category = "not-yet-specified"
    version = "0.1.0"
    edition = "2021"
    with_unit_tests = true
    args_deps = [
      "//userspace/developer/ffx/core:lib",
      "//userspace/developer/ffx/plugins/emulator/configuration:ffx_emulator_config",
      "//third_party/rust_crates:argh",
    ]
    deps = [
      "//userspace/developer/ffx/config:lib",
      "//userspace/developer/ffx/lib/emulator_instance:lib",
      "//userspace/developer/ffx/lib/emulator_instance:lib",
      "//userspace/developer/ffx/lib/errors:lib",
      "//userspace/developer/ffx/lib/fho:lib",
      "//userspace/developer/ffx/lib/writer:lib",
      "//userspace/developer/ffx/plugins/emulator/configuration:ffx_emulator_config",
      "//userspace/developer/ffx/plugins/emulator/engines:ffx_emulator_engines",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:async-trait",
    ]
    args_sources = [ "src/args.rs" ]
    sources = [ "src/lib.rs" ]
  }

  group("tests") {
    testonly = true
    deps = [ ":ffx_emulator_console_test($host_toolchain)" ]
  }
}
