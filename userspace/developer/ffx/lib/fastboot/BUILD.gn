if (is_host) {
  import("//release/rust/rustc_library.gni")
  import("//release/rust/rustc_test.gni")
  import("//release/testing/test_spec.gni")

  rustc_library("lib") {
    name = "ffx_fastboot"
    edition = "2021"
    with_unit_tests = true

    deps = [
      "//release/sdk/meta:rust",
      "//userspace/developer/ffx/config:lib",
      "//userspace/developer/ffx/lib/errors:lib",
      "//userspace/developer/ffx/lib/fastboot/interface:lib",
      "//userspace/developer/ffx/lib/fastboot/transport/factory:lib",
      "//userspace/developer/ffx/lib/fastboot/transport/interface:lib",
      "//userspace/developer/ffx/lib/fastboot_file_discovery:lib",
      "//userspace/developer/ffx/lib/netext:lib",
      "//userspace/developer/ffx/lib/pbms:lib",
      "//userspace/developer/ffx/lib/sdk:lib",
      "//userspace/lib/assembly/partitions_config",
      "//userspace/lib/usb_bulk/rust:lib",
      "//userspace/storage/lib/sparse/rust:lib",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:async-fs",
      "//third_party/rust_crates:async-trait",
      "//third_party/rust_crates:base64",
      "//third_party/rust_crates:byteorder",
      "//third_party/rust_crates:camino",
      "//third_party/rust_crates:chrono",
      "//third_party/rust_crates:flate2",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:ring",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:serde_json",
      "//third_party/rust_crates:tar",
      "//third_party/rust_crates:tempfile",
      "//third_party/rust_crates:thiserror",
      "//third_party/rust_crates:tokio",
      "//third_party/rust_crates:tracing",
      "//third_party/rust_crates:walkdir",
      "//third_party/rust_crates:zip",
    ]

    test_deps = [ "//userspace/lib/fuchsia-async" ]

    sources = [
      "src/boot/mod.rs",
      "src/common/cmd.rs",
      "src/common/crypto.rs",
      "src/common/fastboot.rs",
      "src/common/mod.rs",
      "src/common/vars.rs",
      "src/file_resolver/mod.rs",
      "src/file_resolver/resolvers.rs",
      "src/info/mod.rs",
      "src/lib.rs",
      "src/lock/mod.rs",
      "src/manifest/mod.rs",
      "src/manifest/resolvers.rs",
      "src/manifest/v1.rs",
      "src/manifest/v2.rs",
      "src/manifest/v3.rs",
      "src/unlock/mod.rs",
      "src/util.rs",
    ]
  }

  group("fastboot") {
    public_deps = [ ":lib" ]
  }

  group("tests") {
    testonly = true
    deps = [
      ":lib_test",
      "./interface:tests",
      "./transport/factory:tests",
      "./transport/interface:tests",
    ]
  }
}
