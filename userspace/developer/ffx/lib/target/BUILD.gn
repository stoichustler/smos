import("//release/rust/rustc_library.gni")

if (is_host) {
  rustc_library("lib") {
    name = "ffx_target"
    version = "0.1.0"
    edition = "2021"
    with_unit_tests = true

    deps = [
      "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_fdomain",
      "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust",
      "//sdk/fidl/fuchsia.io:fuchsia.io_fdomain",
      "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
      "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
      "//userspace/connectivity/overnet/lib/circuit",
      "//userspace/connectivity/overnet/lib/core",
      "//userspace/developer/ffx/command/error:lib",
      "//userspace/developer/ffx/config:lib",
      "//userspace/developer/ffx/fidl:fuchsia.developer.ffx_rust",
      "//userspace/developer/ffx/lib/addr:lib",
      "//userspace/developer/ffx/lib/compat_info:lib",
      "//userspace/developer/ffx/lib/discovery:lib",
      "//userspace/developer/ffx/lib/emulator_instance:lib",
      "//userspace/developer/ffx/lib/errors:lib",
      "//userspace/developer/ffx/lib/fastboot_file_discovery:lib",
      "//userspace/developer/ffx/lib/manual_targets:lib",
      "//userspace/developer/ffx/lib/netext:lib",
      "//userspace/developer/ffx/lib/rcs:lib",
      "//userspace/developer/ffx/lib/ssh:lib",
      "//userspace/developer/ffx/lib/target_errors:lib",
      "//userspace/developer/ffx/lib/timeout:lib",
      "//userspace/lib/async-utils",
      "//userspace/lib/fdomain/client",
      "//userspace/lib/fdomain/local",
      "//userspace/lib/fidl/rust/fidl",
      "//userspace/lib/fuchsia-async",
      "//userspace/lib/versioning/version-history/rust/data",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:async-channel",
      "//third_party/rust_crates:async-lock",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:futures-lite",
      "//third_party/rust_crates:itertools",
      "//third_party/rust_crates:nix",
      "//third_party/rust_crates:thiserror",
      "//third_party/rust_crates:tokio",
      "//third_party/rust_crates:tracing",
    ]

    test_deps = [
      "//userspace/lib/fuchsia",
      "//third_party/rust_crates:mockall",
    ]

    sources = [
      "src/connection.rs",
      "src/fdomain_transport.rs",
      "src/fidl_pipe.rs",
      "src/lib.rs",
      "src/resolve.rs",
      "src/ssh_connector.rs",
      "src/target_connector.rs",
    ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":lib_test($host_toolchain)" ]
}

group("target") {
  deps = [ ":lib($host_toolchain)" ]
}
