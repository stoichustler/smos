import("//release/components.gni")
import("//release/assembly/bootfs_files_for_assembly.gni")

executable("bin") {
  output_name = "uname"

  sources = [ "uname.c" ]

  deps = [ "//userspace/zircon/lib/zircon" ]
}

fuchsia_package("uname") {
  deps = [ ":bin" ]
}

bootfs_files_for_assembly("bootfs") {
  deps = [ ":bin" ]
}
