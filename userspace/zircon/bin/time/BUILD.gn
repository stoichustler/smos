import("//release/components.gni")
import("//release/assembly/bootfs_files_for_assembly.gni")

executable("bin") {
  output_name = "time"

  sources = [ "time.c" ]

  deps = [
    "//sdk/lib/fdio",
    "//userspace/zircon/lib/zircon",
  ]
}

fuchsia_package("time") {
  deps = [ ":bin" ]
}

bootfs_files_for_assembly("bootfs") {
  deps = [ ":bin" ]
}
