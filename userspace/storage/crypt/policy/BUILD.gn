import("//release/rust/rustc_library.gni")

rustc_library("lib") {
  edition = "2021"
  deps = [
    "//userspace/lib/fuchsia-fs",
    "//userspace/security/lib/kms-stateless/rust",
    "//third_party/rust_crates:anyhow",
  ]
  sources = [ "src/lib.rs" ]
  name = "crypt_policy"
  with_unit_tests = false
}

group("policy") {
  public_deps = [ ":lib" ]
}
