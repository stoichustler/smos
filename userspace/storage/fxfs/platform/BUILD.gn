rustc_library("platform") {
  edition = "2021"
  with_unit_tests = true
  name = "fxfs-platform"
  deps = []
  sources = [ "src/lib.rs" ]
  test_deps = []
  if (is_fuchsia) {
    sources += platform_sources
    deps += platform_deps
    test_deps += [
      "//userspace/lib/fdio/rust:fdio",
      "//userspace/lib/fuchsia",
      "//userspace/lib/fuchsia-component",
      "//userspace/lib/fuchsia-fs",
      "//userspace/lib/test_util",
      "//userspace/storage/blobfs/bin:blobfs-component",
      "//userspace/storage/crypt/fxfs:lib",
      "//userspace/storage/fxfs:lib",
      "//userspace/storage/fxfs/crypto/insecure",
      "//userspace/storage/lib/blob_writer:blob-writer",
      "//userspace/storage/lib/fs_management/rust:fs_management",
      "//userspace/storage/lib/fsverity-merkle",
      "//userspace/storage/lib/ramdevice_client/rust:ramdevice_client",
      "//userspace/sys/pkg/lib/fuchsia-merkle",
      "//third_party/rust_crates:assert_matches",
      "//third_party/rust_crates:libc",
      "//third_party/rust_crates:rand",
    ]
  }
  visibility = [ "//userspace/storage/fxfs/*" ]
}

rustc_library("fxfs-testing") {
  testonly = true
  edition = "2021"
  features = [ "testing" ]
  sources = platform_sources + [ "src/testing.rs" ]
  source_root = "src/testing.rs"
  deps = platform_deps + [
           "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
           "//sdk/rust/zx",
           "//userspace/lib/fidl/rust/fidl",
           "//userspace/storage/fxfs:lib",
           "//userspace/storage/fxfs/crypto",
           "//userspace/storage/fxfs/crypto/insecure",
           "//userspace/storage/lib/storage_device",
           "//userspace/storage/lib/vfs/rust:vfs",
           "//third_party/rust_crates:anyhow",
         ]
  visibility = [
    "//sdk/lib/zxio/tests/*",
    "//userspace/starnix/kernel/*",
    "//userspace/storage/conformance/conformance_harness/fxfs/*",
    "//userspace/storage/fxfs/*",
  ]
}
