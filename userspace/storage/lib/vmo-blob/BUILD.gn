import("//release/rust/rustc_library.gni")

rustc_library("vmo-blob") {
  edition = "2021"
  version = "0.1.0"
  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/rust/zx",
    "//userspace/storage/lib/vfs/rust:vfs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
  ]

  sources = [ "src/lib.rs" ]

  visibility = [
    "//userspace/storage/*",
    "//userspace/sys/pkg/*",
  ]

  configs += [ "//release/config/rust/lints:clippy_warn_all" ]
}
