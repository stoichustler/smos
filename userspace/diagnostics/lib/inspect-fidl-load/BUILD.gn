import("//release/components.gni")
import("//release/rust/rustc_library.gni")

rustc_library("inspect-fidl-load") {
  version = "0.1.0"
  edition = "2021"
  with_unit_tests = true

  visibility = [
    "//userspace/connectivity/network/tests/integration/common:*",
    "//userspace/diagnostics/archivist/*",
    "//userspace/diagnostics/iquery/*",
    "//userspace/diagnostics/lib/inspect-fidl-load/*",
  ]

  deps = [
    "//sdk/fidl/fuchsia.inspect.deprecated:fuchsia.inspect.deprecated_rust",
    "//sdk/rust/zx",
    "//userspace/lib/diagnostics/inspect/rust",
    "//userspace/lib/fdio/rust:fdio",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia-async",
    "//third_party/rust_crates:anyhow",
  ]

  test_deps = [
    "//userspace/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:maplit",
  ]

  sources = [ "src/lib.rs" ]

  configs += [ "//release/config/rust/lints:clippy_warn_all" ]
}

fuchsia_unittest_package("inspect-fidl-load-test") {
  deps = [ ":inspect-fidl-load_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":inspect-fidl-load-test" ]
}
