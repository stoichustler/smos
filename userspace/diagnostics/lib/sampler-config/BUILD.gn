import("//release/components.gni")
import("//release/rust/rustc_library.gni")

rustc_library("sampler-config") {
  edition = "2021"
  with_unit_tests = true

  visibility = [
    "//userspace/connectivity/network/tests/integration/inspect/*",
    "//userspace/diagnostics/lib/sampler-config/*",
    "//userspace/diagnostics/sampler/*",
    "//userspace/diagnostics/tools/merge_sampler_configs:*",
    "//userspace/lib/assembly/platform_configuration/*",
  ]

  deps = [
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
    "//userspace/lib/diagnostics/selectors",
    "//userspace/sys/lib/component_id_index",
    "//userspace/sys/lib/moniker",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:thiserror",
  ]

  test_deps = [
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:serde_json5",
  ]

  sources = [
    "src/assembly/mod.rs",
    "src/common.rs",
    "src/lib.rs",
    "src/runtime/mod.rs",
    "src/utils.rs",
  ]

  configs += [ "//release/config/rust/lints:clippy_warn_all" ]
}

fuchsia_unittest_package("sampler-config-tests") {
  manifest = "meta/test.cml"
  deps = [ ":sampler-config_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":sampler-config-tests",
    ":sampler-config_test($host_toolchain)",
  ]
}
