import("//release/components.gni")
import("//release/rust/rustc_binary.gni")
import("//release/rust/rustc_library.gni")

iquery_deps = [
  "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust",
  "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
  "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
  "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
  "//userspace/lib/diagnostics/data/rust",
  "//userspace/lib/diagnostics/hierarchy/rust",
  "//userspace/lib/diagnostics/selectors",
  "//userspace/lib/fidl/rust/fidl",
  "//userspace/lib/fuchsia-fs",
  "//userspace/sys/lib/cm_rust",
  "//userspace/sys/lib/component_debug",
  "//userspace/sys/lib/moniker",
  "//third_party/rust_crates:anyhow",
  "//third_party/rust_crates:argh",
  "//third_party/rust_crates:derivative",
  "//third_party/rust_crates:either",
  "//third_party/rust_crates:nom",
  "//third_party/rust_crates:num-traits",
  "//third_party/rust_crates:serde",
  "//third_party/rust_crates:serde_json",
  "//third_party/rust_crates:thiserror",
]

if (is_fuchsia) {
  iquery_deps += [ "//userspace/lib/diagnostics/reader/rust" ]
}

iquery_sources = [
  "src/commands/list.rs",
  "src/commands/list_accessors.rs",
  "src/commands/mod.rs",
  "src/commands/selectors.rs",
  "src/commands/show.rs",
  "src/commands/types.rs",
  "src/commands/utils.rs",
  "src/text_formatter.rs",
  "src/types.rs",
]

if (is_fuchsia) {
  iquery_sources += [
    "src/command_line.rs",
    "src/commands/target.rs",
  ]
}

rustc_library("lib") {
  name = "iquery"
  edition = "2021"
  with_unit_tests = true
  source_root = "src/lib.rs"

  visibility = [
    "//userspace/developer/ffx/plugins/inspect/*",
    "//userspace/developer/remote-control/diagnostics-bridge/*",
    "//userspace/diagnostics/iquery/*",
    "//vendor/google/starnix/tests/*",
  ]

  deps = iquery_deps

  test_deps = [
    "//userspace/diagnostics/iquery/test_support:iquery_test_support",
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:test-case",
  ]

  sources = iquery_sources
  sources += [ "src/lib.rs" ]

  configs += [ "//release/config/rust/lints:clippy_warn_all" ]
}

rustc_binary("bin") {
  output_name = "iquery"
  edition = "2021"
  source_root = "src/main.rs"

  if (is_fuchsia) {
    configs += [ "//release/config/rust:bootfs" ]
  }

  deps = [
    ":lib",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
  ]

  sources = [ "src/main.rs" ]

  configs += [ "//release/config/rust/lints:clippy_warn_all" ]
}

fuchsia_unittest_package("test_iquery_lib_unittests") {
  deps = [
    ":lib_test",
    "//userspace/diagnostics/iquery/test_support:iquery_test_support",
    "//third_party/rust_crates:assert_matches",
  ]
}

rustc_test("iquery_test") {
  edition = "2021"
  output_name = "iquery_test"
  source_root = "src/main.rs"
  deps = [
    ":lib",
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
    "//sdk/fidl/fuchsia.inspect:fuchsia.inspect_rust",
    "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
    "//sdk/fidl/fuchsia.tracing.provider:fuchsia.tracing.provider_rust",
    "//sdk/rust/zx",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/fuchsia-component-test",
    "//userspace/sys/lib/cm_rust",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:pretty_assertions",
    "//third_party/rust_crates:regex",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
  ]
  sources = [
    "src/main.rs",
    "src/tests/commands.rs",
    "src/tests/mod.rs",
    "src/tests/utils.rs",
  ]
  inputs = [
    "test_data/list_accessors.json",
    "test_data/list_accessors.text",
    "test_data/list_archive.json",
    "test_data/list_archive.text",
    "test_data/list_filter_manifest.json",
    "test_data/list_filter_manifest.text",
    "test_data/list_no_dups.json",
    "test_data/list_no_dups.text",
    "test_data/list_test.json",
    "test_data/list_test.text",
    "test_data/list_with_url.json",
    "test_data/list_with_url.text",
    "test_data/selectors_filter_test_serve_fs.json",
    "test_data/selectors_filter_test_serve_fs.text",
    "test_data/selectors_filter_test.json",
    "test_data/selectors_filter_test.text",
    "test_data/selectors_test.json",
    "test_data/selectors_test.text",
    "test_data/show_filter_test.text",
    "test_data/show_filter_test.json",
    "test_data/show_filter_test_serve_fs.text",
    "test_data/show_filter_test_serve_fs.json",
    "test_data/show_test.json",
    "test_data/show_test.text",
  ]

  configs += [ "//release/config/rust/lints:clippy_warn_all" ]
}

fuchsia_component("iquery-test") {
  testonly = true
  manifest = "meta/iquery-test.cml"
  deps = [ ":iquery_test" ]
  check_includes = false
}

fuchsia_test_package("iquery-tests") {
  test_components = [ ":iquery-test" ]
  deps = [
    "test/basic_component",
    "test/test_component",
    "test_data:goldens",
    "//userspace/diagnostics/archivist:archivist-for-embedding-bundle",
  ]
}

group("tests") {
  testonly = true

  deps = [
    ":iquery-tests",
    ":lib_test($host_toolchain)",
    ":test_iquery_lib_unittests",
  ]
}

group("iquery") {
  deps = [
    ":bin",
    "//release/validate:non_production_tag",
  ]
}

fuchsia_package("package") {
  package_name = "iquery"
  deps = [ ":iquery" ]
}
