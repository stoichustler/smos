import("//release/components.gni")
import("//release/rust/rustc_library.gni")

rustc_library("blobfs") {
  name = "blobfs"
  with_unit_tests = true
  edition = "2021"

  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_rust",
    "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
    "//sdk/rust/zx",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/fuchsia-fs",
    "//userspace/storage/fxfs/fidl/fuchsia.fxfs:fuchsia.fxfs_rust",
    "//userspace/storage/lib/delivery_blob",
    "//userspace/storage/lib/vfs/rust:vfs",
    "//userspace/storage/lib/vmo-blob",
    "//userspace/sys/pkg/lib/fuchsia-hash",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:thiserror",
  ]

  test_deps = [
    "//userspace/lib/fuchsia-async",
    "//userspace/sys/pkg/lib/fuchsia-merkle",
    "//userspace/sys/pkg/testing/blobfs-ramdisk",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:maplit",
  ]

  sources = [
    "src/lib.rs",
    "src/mock.rs",
  ]
  configs += [ "//release/config/rust/lints:clippy_warn_all" ]
}

fuchsia_unittest_package("blobfs-lib-tests") {
  manifest = "meta/blobfs-lib-test.cml"
  deps = [
    ":blobfs_test",
    "//userspace/storage/fxfs:fxfs_component",
    "//userspace/storage/testing:storage_driver_test_realm",
  ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  public_deps = [ ":blobfs-lib-tests" ]
}
