import("//release/components.gni")
import("//release/rust/rustc_binary.gni")
import("//release/rust/rustc_library.gni")

rustc_library("lib") {
  name = "run_test_suite_lib"
  with_unit_tests = true
  edition = "2021"

  # Only to be used by internal bin and tests.
  visibility = [
    ":*",
    "tests/*",
    "//userspace/developer/ffx/lib/testing/*",
    "//userspace/developer/ffx/plugins/test/*",
    "//userspace/devices/lib/driver-conformance/*",
    "//userspace/sys/test_runners/rust/tests/*",
  ]

  deps = [
    "directory",
    "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
    "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
    "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust",
    "//sdk/rust/zx-status",
    "//userspace/lib/diagnostics/data/rust",
    "//userspace/lib/diagnostics/selectors",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-fs",
    "//userspace/lib/fuchsia-sync",
    "//userspace/lib/test_diagnostics/rust:test_diagnostics",
    "//userspace/lib/testing/test_list",
    "//userspace/sys/lib/cm_rust",
    "//userspace/sys/lib/component_debug",
    "//userspace/sys/lib/moniker",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:pin-project",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:vte",
  ]

  test_deps = [
    "//userspace/lib/diagnostics/selectors",
    "//userspace/lib/fuchsia",
    "//userspace/lib/testing/fixture",
    "//third_party/rust_crates:ansi_term",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:maplit",
    "//third_party/rust_crates:tempfile",
    "//third_party/rust_crates:zstd",
    "//third_party/zstd",
  ]

  if (!is_host) {
    deps += [ "//userspace/lib/trace/rust:trace" ]

    test_deps += [
      "//sdk/rust/zx",
      "//userspace/lib/fuchsia-component",
      "//userspace/storage/lib/vfs/rust:vfs",
    ]
  }

  sources = [
    "src/artifacts.rs",
    "src/cancel.rs",
    "src/connector.rs",
    "src/diagnostics.rs",
    "src/lib.rs",
    "src/outcome.rs",
    "src/output/directory.rs",
    "src/output/directory_with_stdout.rs",
    "src/output/line.rs",
    "src/output/memory.rs",
    "src/output/mod.rs",
    "src/output/mux.rs",
    "src/output/noop.rs",
    "src/output/shell/mod.rs",
    "src/output/shell/writer.rs",
    "src/params.rs",
    "src/realm.rs",
    "src/run.rs",
    "src/running_suite.rs",
    "src/stream_util.rs",
    "src/trace.rs",
  ]
}

rustc_binary("bin") {
  output_name = "run-test-suite"
  with_unit_tests = true
  edition = "2021"

  configs += [ "//release/config/rust:bootfs" ]

  deps = [
    ":lib",
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
    "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust",
    "//sdk/rust/zx",
    "//userspace/lib/diagnostics/data/rust",
    "//userspace/lib/diagnostics/selectors",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/trace/rust:trace-provider",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]

  sources = [ "src/main.rs" ]
}

fuchsia_package("run_test_suite") {
  testonly = true
  deps = [ ":bin" ]
}

fuchsia_component("test_realm") {
  testonly = true
  manifest = "meta/test_realm.cml"
}

fuchsia_component("no_realm_protocol_realm") {
  testonly = true
  manifest = "meta/no_realm_protocol_realm.cml"
}

fuchsia_unittest_component("run-test-suite-lib-test") {
  manifest = "meta/run_test_suite_lib_test.cml"
  deps = [ ":lib_test" ]
}

fuchsia_unittest_component("run-test-suite-bin-test") {
  deps = [ ":bin_test" ]
}

fuchsia_test_package("run-test-suite-unit-tests") {
  test_components = [
    ":run-test-suite-lib-test",
    ":run-test-suite-bin-test",
  ]
  deps = [
    ":no_realm_protocol_realm",
    ":test_realm",
  ]
}

group("tests") {
  testonly = true
  deps = [
    #":lib_test($host_toolchain)",
    ":run-test-suite-unit-tests",
    "directory:tests",
    "tests",
  ]
}

fuchsia_package("package") {
  package_name = "run-test-suite"
  deps = [ ":bin" ]
}
