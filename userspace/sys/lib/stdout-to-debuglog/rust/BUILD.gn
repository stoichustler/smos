import("//release/rust/rustc_library.gni")

rustc_library("stdout-to-debuglog") {
  edition = "2021"
  deps = [
    "//sdk/fidl/fuchsia.boot:fuchsia.boot_rust",
    "//sdk/rust/zx",
    "//userspace/lib/fdio/rust:fdio",
    "//userspace/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
  ]

  sources = [ "src/lib.rs" ]
}

group("rust") {
  public_deps = [ ":stdout-to-debuglog" ]
}
