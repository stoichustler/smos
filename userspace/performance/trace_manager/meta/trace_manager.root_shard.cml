{
    children: [
        {
            name: "core",
            url: "fuchsia-boot:///trace_manager#meta/trace_manager.cm",
            startup: "eager",
            environment: "#elf-env",
        },
    ],
    offer: [
        {
            protocol: [
                "fuchsia.boot.ReadOnlyLog",
                "fuchsia.kernel.DebugResource",
            ],
            from: "parent",
            to: "#core",
        },
    ],
}
