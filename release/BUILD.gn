    "//release/assembly/scripts:bazel_assembly_input_bundle_tool",
    "//release/bazel:*",
    "//release/bazel/assembly/*",
    "//release/bazel/bazel_sdk:*",
    "//release/bazel/bazel_sdk/docs:*",
    "//release/bazel/bazel_sdk/tests:*",
