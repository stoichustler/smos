    "//userspace/sys/pkg/bin/system-update-committer:*",
    "//userspace/sys/pkg/tests/system-update-checker:*",
    "//third_party/network-conformance/*",
    "//vendor/google/*",
    "//vendor/third_party/cobalt_registry:cobalt_registry",
    "//zircon/kernel/lib/userabi/userboot/tests:*",
  ]
}

# All entries in this group MUST specify where the targets in question are used,
# as justification for their existence.
group("core_realm_shards_allowlist") {
  visibility = []

  # Used by in-tree tests
  visibility +=
      [ "//userspace/security/lib/scrutiny/tests/structured_config:core_shard" ]
}

group("legacy_bundle_allowlist") {
  visibility = []

  # Owned closely by the assembly team.
  visibility += [
    "//release/images/*",
    "//userspace/tests/assembly/assemble_image/*",
    "//vendor/google/*",
  ]

  # These are all tests that should ideally not be using a legacy bundle.
  visibility += [
    "//release/testing/boot_tests:*",
    "//userspace/security/lib/scrutiny/collector:*",
    "//userspace/security/lib/scrutiny/tests/structured_config:*",
    "//userspace/security/tests/pkg_test/tests:*",
    "//userspace/sys/component_manager/tests/bootfs_launching_benchmark:*",
    "//userspace/sys/component_manager/tests/fuchsia_boot_resolver:*",
    "//userspace/tests/early-boot-coverage/*",
    "//userspace/tests/limited_netsvc/image:*",
    "//third_party/network-conformance/images:*",
    "//zircon/kernel/lib/userabi/userboot/tests:*",
    "//zircon/kernel/phys/test/debugdata-propagation:*",
    "//zircon/system/ulib/c/test:*",
    "//zircon/system/ulib/uart/test/interrupt-test:*",
    "//zircon/system/utest/core:*",
  ]
}
