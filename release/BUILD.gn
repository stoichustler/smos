  ]

  # Bluetooth Bazel test packages are wrapped in the bazel_fuchsia_test_package
  # GN rule, which has unspecified outputs.
  # bt-host tests will be migrated out-of-tree.
  visibility += [
    "//userspace/connectivity/bluetooth/core/bt-host:bazel_test_pkg",
    "//userspace/connectivity/bluetooth/core/bt-host:bazel_test_pkg.bazel_build",
    "//userspace/connectivity/bluetooth/core/bt-host:bt-host",
