# These are lints which should be applied to all code.
config("clippy_warn_default") {
  # Use -W instead of -D to treat as a warning while iterating.
  rustflags = [
    # go/keep-sorted start

    "-Wclippy::correctness",
    "-Wclippy::expect_fun_call",
    "-Wclippy::large_enum_variant",
    "-Wclippy::large_futures",
    "-Wclippy::missing_safety_doc",
    "-Wclippy::unnecessary_mut_passed",

    # go/keep-sorted end
  ]
}

# These are lints which should be applied to all non-test code.
config("clippy_warn_production") {
  # Use -W instead of -D to treat as a warning while iterating.
  rustflags = [
    # go/keep-sorted start

    "-Wclippy::clear_with_drain",
    "-Wclippy::collection_is_never_read",
    "-Wclippy::needless_collect",
    "-Wclippy::or_fun_call",
    "-Wclippy::perf",
    "-Wclippy::redundant_clone",
    "-Wclippy::set_contains_or_insert",
    "-Wclippy::unnecessary_lazy_evaluations",

    # go/keep-sorted end
  ]
}

config("deny_unused_crate_dependencies") {
  # Use -W instead of -D to treat as a warning while iterating
  # Unused crate dependencies will still be denied in CQ because of -Dwarnings
  rustflags = [ "-Wunused_crate_dependencies" ]
}

# This is preferred over adding `#![warn(clippy::all)]` in source because
# it's easier to override
config("clippy_warn_all") {
  rustflags = [ "-Wclippy::all" ]
}

# TODO(https://fxbug.dev/42055130): Delete this config when all unused
# dependencies are removed.
#
# PLEASE DO NOT USE.
config("allow_unused_crate_dependencies") {
  rustflags = [ "-Aunused_crate_dependencies" ]

  # Please do not add to this list.
  visibility = [
    "//examples/*",
    "//sdk/*",
    "//userspace/*",
    "//tools/*",
    "//vendor/*",
    "//zircon/*",
  ]
}

config("deny_unused_results") {
  rustflags = [ "-Dunused_results" ]
}

config("allow_unused_results") {
  rustflags = [ "-Aunused_results" ]

  # This visibility list allows for targets to opt out of denying unused results.
  #
  # There is currently no platform mandate to adopt the unused_results lint and it's opt-in for
  # developers that want to use it. See https://fxbug.dev/42153043 for more context.
  #
  # To adopt the lint, add the following to your rust target:
  #   configs -= ["//release/config/rust/lints:allow_unused_results"]
  # The visibility list below can be used to enforce the list on certain areas of the tree while
  # we evaluate wider adoption.
  #
  # To update this list run:
  # $ tools/scripts/gn/gen_visibility_globs.py \
  #    --all=//release/config/rust/lints:deny_unused_results \
  #    --allow=//release/config/rust/lints:allow_unused_results \
  #    --ignore-suffix=_rust  # FIDL bindings use the _rust suffix
  visibility = [
    "//release/*",
    "//examples/*",
    "//garnet/*",
    "//sdk/*",
    "//userspace/android/api/*",  # Used in code generated by the aidl compiler.
    "//userspace/bringup/*",
    "//userspace/camera/*",
    "//userspace/cobalt/*",
    "//userspace/connectivity/bluetooth/lib/bt-metrics:*",
    "//userspace/connectivity/location/*",
    "//userspace/connectivity/lowpan/*",
    "//userspace/connectivity/network/metrics:*",
    "//userspace/connectivity/network/net-cli/ffx:*",
    "//userspace/connectivity/network/testing/network-test-realm/ffx:*",
    "//userspace/connectivity/openthread/*",
    "//userspace/connectivity/overnet/*",
    "//userspace/connectivity/policy/reachability/*",
    "//userspace/connectivity/ppp/*",
    "//userspace/connectivity/telephony/*",
    "//userspace/connectivity/weave/*",
    "//userspace/connectivity/wlan/*",
    "//userspace/developer/*",
    "//userspace/devices/*",
    "//userspace/diagnostics/*",
    "//userspace/experiences/*",
    "//userspace/factory/*",
    "//userspace/fonts/*",
    "//userspace/graphics/*",
    "//userspace/hwinfo/*",
    "//userspace/identity/*",
    "//userspace/intl/*",
    "//userspace/lib/*",
    "//userspace/media/*",
    "//userspace/paravirtualization/*",
    "//userspace/performance/*",
    "//userspace/power/*",
    "//userspace/recovery/*",
    "//userspace/security/*",
    "//userspace/sensors/*",
    "//userspace/session/*",
    "//userspace/settings/service:*",
    "//userspace/starnix/*",
    "//userspace/storage/*",
    "//userspace/sys/*",
    "//userspace/tee/*",
    "//userspace/testing/*",
    "//userspace/tests/*",
    "//userspace/ui/*",
    "//userspace/virtualization/*",
    "//userspace/zircon/*",
    "//third_party/*",
    "//tools/*",
    "//vendor/*",
    "//zircon/*",
  ]
}
