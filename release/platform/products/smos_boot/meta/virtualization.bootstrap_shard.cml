{
    children: [
        {
            name: "vmm-launcher",
            url: "fuchsia-boot:///smos-virtualization-host#meta/vmm_launcher.cm",
        },
        {
            name: "zircon-guest-manager",
            url: "fuchsia-boot:///smos-virtualization-host#meta/zircon_guest_manager.cm",
        },
        {
            name: "linux-guest-manager",
            url: "fuchsia-boot:///smos-virtualization-host#meta/linux_guest_manager.cm",
        },
    ],
    offer: [
        {
            protocol: [
                "fuchsia.kernel.HypervisorResource",
                "fuchsia.kernel.VmexResource",
            ],
            from: "parent",
            to: [ "#vmm-launcher", "#zircon-guest-manager", "#linux-guest-manager" ],
        },
        {
            protocol: "fuchsia.kernel.HypervisorResource",
            from: "parent",
            to: "#console-launcher",
        },
        {
            protocol: "fuchsia.virtualization.ZirconGuestManager",
            from: "#zircon-guest-manager",
            to: "#console-launcher",
        },
        {
            protocol: "fuchsia.virtualization.LinuxGuestManager",
            from: "#linux-guest-manager",
            to: "#console-launcher",
        },
        {
            protocol: "fuchsia.scheduler.RoleManager",
            from: "#role_manager",
            to: [ "#vmm-launcher", "#zircon-guest-manager", "#linux-guest-manager" ],
        },
        {
            protocol: "fuchsia.sysinfo.SysInfo",
            from: "#sysinfo",
            to: [ "#vmm-launcher", "#zircon-guest-manager", "#linux-guest-manager" ],
        },
        {
            dictionary: "diagnostics",
            from: "self",
            to: [ "#vmm-launcher", "#zircon-guest-manager", "#linux-guest-manager" ],
        },
    ],
}
