import("//release/product.gni")

assert(is_fuchsia, "This can only be included in default_toolchain contexts")

# This group is for tools in packages that should be compiled for Fuchsia
group("tools") {
  testonly = true
  if (smos_minimal_assembly) {
    public_deps = []
  } else {
    public_deps = [
      "//userspace/camera:tools",
      "//userspace/connectivity/bluetooth/tools",
      "//userspace/developer/debug/debug_agent",
      "//userspace/developer/fastboot",
      "//userspace/devices/bundles:tools",
      "//userspace/graphics/display:tools",
      "//userspace/graphics/lib/magma:magma-tools",
      "//userspace/performance/trace",
      "//userspace/recovery/factory_reset:tools",
      "//userspace/storage:tools",
      "//userspace/sys/pkg/bin/far",
      "//userspace/sys/tools/activity-ctl",
      "//userspace/sys/tools/log",
      "//userspace/ui/tools:scenic",
      "//third_party/boringssl:boringssl_tool",
      "//third_party/curl:curl_pkg",
      "//third_party/iperf:iperf3_pkg",
      "//third_party/openssh-portable:scp-shell-pkg",
      "//third_party/openssh-portable:ssh-keygen-shell-pkg",
      "//third_party/openssh-portable:ssh-shell-pkg",
    ]
  }
  deps = [ "//release/validate:non_production_tag" ]

  # These are libraries that were being included in tools?
  # "//userspace/security/lib/scrutiny",
}

# This group is for host tools. The SMOS image build invokes only the
# architecture-specific SDK tools and does not need this general-purpose host
# tool bundle, which also depends on pruned source trees.
_host_tools = []
if (!smos_boot_build) {
  _host_tools = [
    "//release/tools/formatjson5:install",
    "//userspace/developer/debug/zxdb:zxdb",
    "//userspace/diagnostics/triage:install",
    "//userspace/lib/chunked-compression:chunked-compress-host-tool",
    "//userspace/lib/icu/tools/extractor:host",
    "//userspace/performance/lib/trace_processing:run_cpu_breakdown",
    "//userspace/performance/trace2json",
    "//userspace/storage:host_tools",
    "//userspace/sys/pkg/bin/far:host",
    "//tools",
    "//tools/check-licenses:host",
    "//tools/whereiscl:host",
  ]
}
group("host_tools") {
  testonly = true
  public_deps = []
  foreach(dep, _host_tools) {
    public_deps += [ "${dep}($host_toolchain)" ]
  }
}
