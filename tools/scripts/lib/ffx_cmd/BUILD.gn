import("//release/host.gni")
import("//release/python/python_host_test.gni")
import("//release/python/python_library.gni")
import("//release/python/python_mobly_test.gni")

group("tests") {
  testonly = true

  deps = [ ":ffx_cmd_tests($host_toolchain)" ]
}

group("e2e_tests") {
  testonly = true
  deps = [ ":ffx_cmd_inspect_e2e_test($host_toolchain)" ]
}

if (is_host) {
  python_library("ffx_cmd") {
    sources = [
      "__init__.py",
      "inspect.py",
      "lib.py",
      "version.py",
    ]
    deps = [
      "//tools/scripts/lib/async_utils",
      "//tools/scripts/lib/fx_cmd",
      "//userspace/lib/diagnostics/python/fuchsia_inspect",
    ]
  }

  python_host_test("ffx_cmd_tests") {
    main_source = "tests/test_ffx_cmd.py"
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
    libraries = [
      ":ffx_cmd",
      "//tools/scripts/lib/async_utils",
    ]
    test_data_deps = [ "//userspace/developer/ffx:suite_test_data" ]
  }

  python_mobly_test("ffx_cmd_inspect_e2e_test") {
    main_source = "e2e_tests/test_ffx_inspect.py"
    libraries = [
      "//userspace/testing/end_to_end/honeydew",
      "//userspace/testing/end_to_end/mobly_base_tests:fuchsia_base_test",
      "//userspace/lib/diagnostics/python/fuchsia_inspect",
      ":ffx_cmd",
    ]
  }
}
