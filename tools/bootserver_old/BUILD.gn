import("//release/host.gni")
import("//release/sdk/sdk_host_tool.gni")

executable("bootserver") {
  sources = [
    "bootserver.c",
    "netboot.c",
    "tftp.c",
  ]
  deps = [
    "//userspace/bringup/lib/netboot",
    "//zircon/system/ulib/tftp",
  ]
  configs += [
    # TODO(https://fxbug.dev/42136089): delete the below and fix conversion warnings
    "//release/config:Wno-conversion",

    # TODO(https://fxbug.dev/353575163): delete the below and fix folding-constant warnings
    "//release/config:Wno-gnu-folding-constant",
  ]
}

sdk_host_tool("bootserver_sdk") {
  category = "partner"
  output_name = "bootserver"
  deps = [ ":bootserver" ]
}

install_host_tools("host") {
  deps = [ ":bootserver" ]
  outputs = [ "bootserver" ]
}
