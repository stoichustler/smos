{
  "version": 1,
  "architectures": {
    "arm64": [
      "release/images/fuchsia:fuchsia_assembly",
      "kernel.phys_arm64/linux-arm64-boot-shim.bin",
      "platform/products/smos_boot/virtualization:host",
      "userspace/smos_boot/virtcheck:virtcheck_test"
    ],
    "riscv64": [
      "release/images/fuchsia:fuchsia_assembly",
      "kernel.phys_riscv64/linux-riscv64-boot-shim.bin",
      "userspace/smos_boot/virtcheck:virtcheck_test"
    ]
  },
  "external_links": [],
  "excluded_prefixes": [".git", "out", "prebuilt", ".cipd", "beau"],
  "protected_files": [
    ".gn", ".gitignore", "AGENTS.md", "LICENSE", "Makefile", "PATENTS", "README.md", "SVE-os.md",
    "kept-components.md",
    "zircon/scripts/run-zircon",
