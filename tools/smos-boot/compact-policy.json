    "third_party/golibs/vendor/modules.txt",
    "third_party/rust_crates/vendor/libc-0.2.169/src/fuchsia/riscv64.rs"
  ],
  "protected_trees": [
    "release", "docs/plans",
    "tools/skills",
    "third_party/pylibs/mypy/src/mypy",
    "third_party/pylibs/mypy/src/mypyc",
    "third_party/pylibs/mypy_extensions/src",
    "third_party/pylibs/typing_extensions/src/src",
    "tools/smos-boot"
  ],
  "runtime_forbidden_domains": [
    "bluetooth", "camera", "graphics", "network", "recovery", "update", "wlan"
  ],
  "host_build_only_prefixes": [
    "sdk/fidl/", "userspace/camera/", "userspace/connectivity/", "userspace/graphics/",
    "userspace/media/", "userspace/recovery/", "userspace/ui/"
  ]
