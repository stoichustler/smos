### Directories to be ignored across the tree
.cipd/
.idea/

# For storing local scripts and data files in a source tree.
/out/
/release/secondary/third_party/ffmpeg
/release/secondary/third_party/protobuf

# rust-analyzer
/rust-project.json

# Note that some of those directories not included.
/docs

